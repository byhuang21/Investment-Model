# =============================================================================
# Coffee Can 投研系统环境变量模板
# 复制为 .env 后填入真实值；在 GitHub Actions 中请配置为 Repository Secrets
# =============================================================================

# [必填] SEC EDGAR API 强制要求自定义 User-Agent（格式：应用名 联系邮箱）
SEC_USER_AGENT="CoffeeCanResearch your_email@example.com"

# [可选] 通知推送配置（留空则仅输出到终端与报告文件）
# 支持通用 Webhook（飞书/钉钉/Slack/Discord/自建服务）
ALERT_WEBHOOK_URL=""

# [可选] Telegram Bot 推送
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# [可选] GitHub Issue 告警（在 GitHub Actions 中自动注入 GITHUB_TOKEN）
GITHUB_REPOSITORY=""
